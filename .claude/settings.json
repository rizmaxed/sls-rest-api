{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-dangerous-rm.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/block-secret-commit.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/block-destructive-aws.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/suggest-validate.sh"
          }
        ]
      }
    ]
  }
}
